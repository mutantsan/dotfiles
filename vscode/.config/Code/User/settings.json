{
    // -------------------------------
    // Editor: Behavior
    // -------------------------------
    "editor.copyWithSyntaxHighlighting": false, // do not copy the syntax hl
    "diffEditor.ignoreTrimWhitespace": false, // do not ignore white spaces
    "editor.emptySelectionClipboard": true, // cut/copy line if my cursor is on it
    "editor.snippetSuggestions": "top", // show snippet suggestions on top of other suggestions
    "editor.suggest.showSnippets": true,
    "editor.detectIndentation": false, // do not automatically detect indentation on file open
    "editor.tabSize": 4,
    "editor.largeFileOptimizations": false, // special handling for large files to disable certain memory intensive features
    "editor.hover.delay": 300, // delay in milliseconds after which the hover is shown
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleImplementations": "goto",
    "editor.gotoLocation.multipleReferences": "goto",
    "editor.gotoLocation.multipleDeclarations": "goto",
    "editor.gotoLocation.multipleTypeDefinitions": "goto",

    // -------------------------------
    // Editor: Appearance / hide unused UI
    // -------------------------------
    "editor.minimap.enabled": false, // disable the code minimap
    "editor.glyphMargin": false, // hide breakpoint gutter
    "editor.guides.indentation": false, // don't render indent guides
    "editor.lineNumbers": "off", // hide line numbers
    "workbench.editor.showTabs": "none", // the editor title area is not displayed
    "breadcrumbs.enabled": false, // hide breadcrumbs
    "workbench.tree.renderIndentGuides": "none", // render tree indent guides on hover
    "editor.matchBrackets": "never", // don't highlight matching brackets
    "editor.colorDecorators": false, // don't render the inline color decorators and color picker
    "editor.lightbulb.enabled": "onCode", // show the code action menu when the cursor is on lines with code
    "editor.selectionHighlight": false, // do not highlight matches similar to the selection
    "editor.overviewRulerBorder": false, // don't draw a border around the overview ruler
    "editor.renderLineHighlight": "none", // don't highlight current line
    "editor.occurrencesHighlight": "off", // don't highlight occurrences (we can use Ctrl+F)
    "editor.renderControlCharacters": false, // don't render control characters
    "editor.hideCursorInOverviewRuler": true, // hide cursor position indicator on the scrollbar area
    "workbench.editor.enablePreview": false, // disable preview mode
    "workbench.editor.enablePreviewFromQuickOpen": false, // editors opened from Quick Open don't show as preview
    "workbench.tips.enabled": false, // disable the watermark tips when no editor is open
    "workbench.tree.indent": 16, // tree indentation in pixels

    // -------------------------------
    // Editor: Font / cursor
    // -------------------------------
    "editor.unicodeHighlight.ambiguousCharacters": true, // highlight non-ASCII characters
    "editor.cursorBlinking": "solid", // cursor animation style
    "editor.fontLigatures": true,
    "editor.fontSize": 13,
    "editor.lineHeight": 1.6,
    "editor.fontFamily": "MonoLisa, monospace",

    // -------------------------------
    // Files
    // -------------------------------
    "files.trimTrailingWhitespace": true, // trim trailing whitespace on file save
    "files.insertFinalNewline": true, // insert a final new line at the end of the file when saving it
    "files.trimFinalNewlines": true, // trim extra new lines after the final one
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/*.pyc": true,
        "**/__pycache__": true,
        "**/*.egg-info": true,
        "**/.direnv/": true,
        "**/.ruff_cache": true,
        "**/.pytest_cache": true,
        "**/node_modules/": true
    },
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/__pycache__/**": true,
        "**/venv/**": true
    },
    "files.associations": {
        "*.html": "html",
        "*.twig": "html",
        "*.module": "php"
    },

    // -------------------------------
    // Explorer
    // -------------------------------
    "explorer.compactFolders": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.excludeGitIgnore": true,

    // -------------------------------
    // Search
    // -------------------------------
    "search.useIgnoreFiles": false, // don't use .gitignore/.ignore files when searching
    "search.exclude": {
        "**/*.po": true,
        "**/*.pot": true,
        "**/example_*/": true,
        "**/*.js.map": true,
        "public/base": true,
        "**/storage/webassets/": true,
        "**/ckanext-*/site/": true,
        "**/node_modules/": true,
        "**/dist/": true,
        "**/venv/": true,
        "**/.venv/": true
    },

    // -------------------------------
    // Git / SCM
    // -------------------------------
    "git.decorations.enabled": true, // Git contributes colors and badges to the Explorer and Open Editors view
    "git.openRepositoryInParentFolders": "never",
    "scm.diffDecorations": "all", // show diff decorations in the editor gutter
    "problems.decorations.enabled": true, // show errors & warnings on files and folders

    // -------------------------------
    // Terminal
    // -------------------------------
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.lineHeight": 1.5,

    // -------------------------------
    // Window
    // -------------------------------
    "window.zoomLevel": 3, // 3 is 160%
    "window.title": "${dirty}${activeEditorMedium}${separator}${rootNameShort}",
    "window.newWindowDimensions": "inherit",
    "window.controlsStyle": "hidden",
    "window.commandCenter": false,
    "window.menuBarVisibility": "compact",

    // -------------------------------
    // Workbench
    // -------------------------------
    "workbench.colorTheme": "Ocean Green: Dark",
    "workbench.experimental.modernUI": false,
    "workbench.startupEditor": "none",
    "workbench.sideBar.location": "right",
    "workbench.activityBar.location": "hidden",
    "workbench.navigationControl.enabled": false,
    "workbench.browser.showInTitleBar": false,
    "workbench.layoutControl.enabled": false,
    "workbench.editorActionsLocation": "hidden",
    "workbench.editorLargeFileConfirmation": 25,
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.ui": "default",
        "*.qrc": "qt-core.qrcEditor"
    },

    // -------------------------------
    // Remote
    // -------------------------------
    "remote.autoForwardPortsSource": "hybrid",

    // -------------------------------
    // Chat / Copilot
    // -------------------------------
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "chat.viewSessions.orientation": "stacked",
    "chat.titleBar.signIn.enabled": false,

    // -------------------------------
    // Custom UI Style (extension: custom-ui-style)
    // -------------------------------
    "custom-ui-style.stylesheet": {
        ".quick-input-widget": "top: 50% !important; left: 50% !important; transform: translate(-50%, -50%) !important; border-radius: 0 !important; box-shadow: none !important;", // center quick input box and remove border radius
        ".quick-input-widget .monaco-inputbox": "border-radius: 0 !important",
        ".quick-input-list .scrollbar": "display: none", // hide scroll bar inside the command palette
        ".window-appicon": "display: none;", // center the command palette and modify look
        ".watermark-container .letterpress": "display: none;", // hide the watermark
        ".editor-widget.find-widget": "border: 1px solid #d3d3d3; border-top: unset; box-shadow: unset",
        ".notification-toast": "box-shadow: none !important", // remove box-shadow from notification toast
        ".editor-actions": "display: none", // hide the editor actions (split, settings etc)
        ".agent-status-badge-section": "display: none", // hide the agent status badge
        ".agent-status-badge-section .menu-entry": "display: none", // hide the agent status badge menu
        ".monaco-action-bar .action-item .codicon": "display: none; !important" // hide the more icon in the toolbar
    },

    // -------------------------------
    // Python
    // -------------------------------
    "python.analysis.logLevel": "Information",
    "python.analysis.autoImportCompletions": true, // offer auto-import completions
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.indexing": false,
    "python.analysis.extraPaths": [
        "./ckan",
        "./ckanext-blocksmith",
        "./ckanext-mailcraft",
        "./ckanext-admin-panel",
        "./ckanext-harvest",
        "./ckanext-harvest-basket",
        "./ckanext-dcat",
        "./ckanext-spatial",
        "./ckanext-scheming",
        "./ckanext-xloader",
        "./ckanext-toolbelt",
        "./ckanext-doi",
        "./ckanext-resource-docs",
        "./ckanext-cdp-iar",
        "./ckanext-dataset-series",
        "./ckanext-drupal-idp",
        "./ckanext-drupal-api",
        "./ckanext-tables",
        "./ckanext-transmute",
        "./ckanext-syndicate",
        "./ckanext-files",
        "./ckanext-better-stats",
        "./ckanext-event-audit",
        "./ckanext-knowledge-assistant",
        "./ckanext-theming",
        "./ckanext-portal-core",
        "./ckanext-portal-activity",
        "./ckanext-portal-revision",
        "./ckanext-bulk",
        "./ckanext-ingest",
        "./ckanext-search-autocomplete",
        "./ckanext-unfold",
        "./../ckan"
    ],
    "ruff.configuration": "/home/cherry/projects/pyproject.toml",

    // -------------------------------
    // Language-specific formatters
    // -------------------------------
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[less]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "[scss]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "[css]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "[yml]": {
        "editor.formatOnSave": false,
        "editor.autoIndent": "advanced"
    }
}