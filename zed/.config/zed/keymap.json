[
    // -------------------------------
    // File Explorer
    // -------------------------------
    {
        "context": "ProjectPanel",
        "bindings": {
            "alt-n": "project_panel::NewFile",
            "alt-shift-n": "project_panel::NewDirectory"
        }
    },
    // Skip the confirmation prompt on delete/trash
    {
        "context": "ProjectPanel",
        "bindings": {
            "backspace": ["project_panel::Trash", { "skip_prompt": true }],
            "delete": ["project_panel::Trash", { "skip_prompt": true }],
            "shift-delete": ["project_panel::Delete", { "skip_prompt": true }],
            "ctrl-backspace": ["project_panel::Delete", { "skip_prompt": true }],
            "ctrl-delete": ["project_panel::Delete", { "skip_prompt": true }]
        }
    },

    // -------------------------------
    // Fold & Unfold
    // -------------------------------
    {
        "context": "Editor",
        "bindings": {
            "shift-alt-[": "editor::Fold",
            "shift-alt-]": "editor::UnfoldLines"
        }
    },

    // -------------------------------
    // Split panels
    // -------------------------------
    {
        "context": "Pane",
        "bindings": {
            "shift-alt-=": "pane::SplitRight"
        }
    },
    {
        "context": "Workspace",
        "bindings": {
            "shift-alt-right": "workspace::ActivatePaneRight",
            "shift-alt-left": "workspace::ActivatePaneLeft"
        }
    }
]
