{
    // -------------------------------
    // Update defaults
    // -------------------------------
    "icon_theme": "Zed (Default)",
    "file_types": {
        "HTML": ["*.html", "*.twig"],
        "PHP": ["*.module"]
    },
    "remove_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true,
    "snippet_sort_order": "top",

    // -------------------------------
    // Hide unused UI elements
    // -------------------------------
    "minimap": {
        "show": "never"
    },
    "indent_guides": {
        "enabled": false
    },
    "tab_bar": {
        "show": false
    },
    "toolbar": {
      "breadcrumbs": false,
      "quick_actions": false,
      "selections_menu": false,
      "agent_review": false,
      "code_actions": false
    },
    "gutter": {
        "line_numbers": false
    },
    // Whole bar on/off, plus what shows inside it.
    "status_bar": {
        "experimental.show": true,
        "show_active_file": false,
        "active_language_button": true,
        "cursor_position_button": true,
        "line_endings_button": false,
        "active_encoding_button": "non_utf8",
    },
    // Each of these "button" fields is that panel/feature's own toggle icon in the status bar,
    // separate from the panel itself.
    "project_panel": {
        "button": false,
        "dock": "right",
        "indent_size": 16,
        "auto_fold_dirs": false,
        "git_status": true,
        "indent_guides": {
            "show": "never"
        }
    },
    "outline_panel": {
        "button": false
    },
    "git_panel": {
        "tree_view": false,
        "button": false
    },
    "collaboration_panel": {
        "button": false
    },
    "agent": {
        "button": false
    },
    "diagnostics": {
        "button": true
    },
    "global_lsp_settings": {
        "button": true
    },
    "debugger": {
        "button": false
    },
    "edit_predictions": {
      "provider": "none"
    },

    // -------------------------------
    // Reduce noise
    // -------------------------------
    "hover_popover_delay": 300,
    "current_line_highlight": "none",
    "selection_highlight": false,

    // -------------------------------
    // UI appearance
    // -------------------------------
    // Browse alternatives with ctrl-k ctrl-t (theme_selector::Toggle), or install a theme
    // extension via ctrl-shift-x.
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "One Dark"
    },
    // Requires installing the community "Catppuccin Icons" extension first (ctrl-shift-x).
    // Set this to whatever name it registers and confirm via the icon theme picker.
    // "icon_theme": "Catppuccin Mocha",
    "terminal": {
        "button": false,
        "font_size": 20.0,
        "line_height": {
            "custom": 1.5
        }
    },

    // -------------------------------
    // Window settings
    // -------------------------------
    "title_bar": {
        "show_menus": false
    },

    // -------------------------------
    // Editor settings
    // -------------------------------
    "cursor_blink": false,
    "buffer_font_family": ".ZedMono",
    "buffer_font_size": 20,
    "buffer_line_height": {
        "custom": 1.6
    },
    "buffer_font_features": {
        "calt": true
    },
    "ui_font_size": 20,

    // -------------------------------
    // Search settings
    // -------------------------------
    "search": {
        "include_ignored": true,
        "button": false
    },
    "file_scan_exclusions": [
        "**/.git",
        "**/.svn",
        "**/.hg",
        "**/.jj",
        "**/.sl",
        "**/.repo",
        "**/CVS",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/.classpath",
        "**/.settings",
        "**/*.pyc",
        "**/__pycache__",
        "**/*.egg-info",
        "**/.direnv",
        "**/node_modules",
        "**/.ruff_cache",
        "**/.pytest_cache"
    ],

    // -------------------------------
    // Python configuration
    // -------------------------------
    // basedpyright is a pyright fork with its own settings namespace - "basedpyright.analysis.*",
    // not Pylance's "python.analysis.*" (which it doesn't read at all).
    "lsp": {
        "basedpyright": {
            "settings": {
            }
        }
    },

    // -------------------------------
    // Other
    // -------------------------------
    "base_keymap": "VSCode"
}
